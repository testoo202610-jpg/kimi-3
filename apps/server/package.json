{
  "name": "@cr/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --alias:@cr/core=../../packages/game-core/src/index.ts --alias:@cr/shared=../../packages/shared/src/index.ts --outfile=dist/index.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@cr/core": "*",
    "@cr/shared": "*",
    "@fastify/websocket": "^10.0.1",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.46",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.4",
    "@types/ws": "^8.5.10",
    "typescript": "~5.8.3",
    "vitest": "^3.1.4"
  }
}
